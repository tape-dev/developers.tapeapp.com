{
  "name": "dev-portal",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "runtime=DEV docusaurus start apps/dev-portal --port 3100 --no-open",
    "start-dev": "runtime=DEV docusaurus start apps/dev-portal --port 3100 --no-open",
    "start-prd": "runtime=PRD docusaurus start apps/dev-portal --port 3100 --no-open",
    "serve": "runtime=DEV docusaurus start apps/dev-portal --port 3100 --no-open",
    "build": "docusaurus build apps/dev-portal --out-dir ../../docs",
    "check-links": "node tools/check-doc-links.js",
    "publish": "npm run build && echo 'developers.tapeapp.com' > docs/CNAME && git add ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@mdx-js/react": "^3.1.1",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
